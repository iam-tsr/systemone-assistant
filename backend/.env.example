# This is an example .env file for the backend. Copy this file to .env and fill in the values.

# You can use here JEV too, just replace the values with your JEV credentials.
JEV_BASE_URL=jev_base_url
JEV_API_KEY=jev_api_key
JEV_MODEL=jev_model

OPENAI_BASE_URL=https://api.openai.com/v1       # If using model from different provider, change this to the provider's base URL
OPENAI_API_KEY=openai_api_key
OPENAI_MODEL=openai_model

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=systemone

GNANI_API_KEY=gnani_api_key

CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:27017"]

UNICORN_HOST=localhost
UNICORN_PORT=8001